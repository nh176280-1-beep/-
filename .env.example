HOST=0.0.0.0
DATA_DIR=./data
# 운영 서버에서는 반드시 HTTPS 주소와 production을 지정하세요.
# NODE_ENV=production
# PUBLIC_URL=https://your-app.example.com
# 첫 관리자 생성 시에만 필요합니다. 배포 서비스의 비밀 환경변수로 입력하세요.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# 실제 가격 페이지를 확인한 뒤 지정할 수 있습니다.
